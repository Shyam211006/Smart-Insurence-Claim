# Rename this file to .env before running the server

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/smartclaim

# Secret key used to sign JWT tokens (use any long random string)
JWT_SECRET=smartclaim_super_secret_key_change_this

# Port the backend server will run on
PORT=5001

# Gmail account used to SEND the OTP verification emails (this is YOUR sender account,
# not the user's account being registered).
# EMAIL_PASS must be a 16-character Gmail "App Password" — NOT your normal Gmail password.
# See the README section "Setting up Gmail OTP verification" for how to generate one.
EMAIL_USER=shyamanandaraj57@gmail.com
EMAIL_PASS=abcdefghijklmnop
